# Team URL formats
team_url_formats = {
    "Broncos": ["brisbanebroncos", "brisbane-broncos"],
    "Bulldogs": ["nrl.com", "bulldogs"],
    "Cowboys": ["nrl.com", "cowboys"],
    "Dolphins": ["nrl.com", "dolphins"],
    "Dragons": ["nrl.com", "dragons"],
    "Eels": ["nrl.com", "eels"],
    "Knights": ["nrl.com", "knights"],
    "Sea Eagles": ["nrl.com", "sea-eagles"],
    "Sharks": ["nrl.com", "sharks"],
    "Storm": ["melbournestorm", "melbourne-storm"],
    "Panthers": ["penrithpanthers", "penrith-panthers"],
    "Rabbitohs": ["nrl.com", "south-sydney-rabbitohs"],
    "Raiders": ["nrl.com", "raiders"],
    "Roosters": ["nrl.com", "roosters"],
    "Tigers": ["weststigers", "wests-tigers"],
    "Titans": ["nrl.com", "titans"],
    "Warriors": ["nrl.com", "warriors"]
}

def construct_url(player_name, team):
    """Construct the URL for a player based on their name and team."""
    base_urls = team_url_formats.get(team, [])
    for base_url in base_urls:
        if base_url == "nrl.com":
            url = f"https://www.nrl.com/players/nrl-premiership/{team.lower()}/{player_name.lower().replace(' ', '-')}/"
        else:
            url = f"https://www.{base_url}.com.au/teams/nrl-premiership/{team.lower()}/{player_name.lower().replace(' ', '-')}/"
        yield url

def scrape_dob(url):
    """Scrape the date of birth from the given URL."""
    try:
        response = requests.get(url)
        response.raise_for_status()
        soup = BeautifulSoup(response.text, 'html.parser')
        
        # Find the date of birth
        dob_div = soup.find('div', class_='dl-card-item o-text u-border-bottom u-display-flex')
        if dob_div:
            dob_dt = dob_div.find('dt', class_='dl-card-item__label u-font-weight-500 u-flex-shrink-0')
            if dob_dt and dob_dt.text.strip() == "Date of Birth:":
                dob_dd = dob_div.find('dd')
                if dob_dd:
                    return dob_dd.text.strip()
    except requests.RequestException as e:
        print(f"Error fetching {url}: {e}")
    return None

def main():
    for player in players:
        player_name = player["name"]
        team = player["team"]
        print(f"Searching for {player_name} ({team})...")
        
        for url in construct_url(player_name, team):
            print(f"Trying URL: {url}")
            dob = scrape_dob(url)
            if dob:
                print(f"Found Date of Birth for {player_name} ({team}): {dob}")
                break
        else:
            print(f"Could not find Date of Birth for {player_name} ({team})")

if __name__ == "__main__":
    main()
